<?php

/**
 * Implements hook_uninstall().
 */
function dxp_utilities_uninstall()
{
    // Delete the views configuration if it exists
    \Drupal::configFactory()->getEditable('views.view.dxp_media')->delete();
}

/**
 * Enable the media REST resources for existing installs.
 */
function dxp_utilities_update_10001() {
  $resources = [
    'rest.resource.get_media_entities' => [
      'id' => 'get_media_entities',
      'plugin_id' => 'get_media_entities',
      'granularity' => 'method',
      'configuration' => [
        'GET' => [
          'supported_formats' => ['json'],
          'supported_auth' => ['basic_auth', 'cookie'],
        ],
      ],
      'status' => TRUE,
      'langcode' => 'en',
      'dependencies' => [
        'module' => ['basic_auth', 'serialization'],
      ],
    ],
    'rest.resource.delete_media_entities' => [
      'id' => 'delete_media_entities',
      'plugin_id' => 'delete_media_entities',
      'granularity' => 'method',
      'configuration' => [
        'POST' => [
          'supported_formats' => ['json'],
          'supported_auth' => ['basic_auth', 'cookie'],
        ],
      ],
      'status' => TRUE,
      'langcode' => 'en',
      'dependencies' => [
        'module' => ['basic_auth', 'serialization'],
      ],
    ],
  ];

  $config_factory = \Drupal::configFactory();

  foreach ($resources as $name => $data) {
    $config = $config_factory->getEditable($name);
    $config->setData($data);
    $config->save(TRUE);
  }
}
